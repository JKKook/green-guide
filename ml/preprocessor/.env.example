# Supabase credentials
# 1. Supabase Dashboard → Project Settings → API 에서 복사
# 2. 이 파일을 .env 로 복사한 뒤 실제 값으로 채우기
# 3. .env 는 절대 git 에 커밋하지 말 것

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Storage bucket 이름 (Supabase Dashboard 에서 미리 생성)
SUPABASE_BUCKET=raw-images

# Postgres 테이블 이름
SUPABASE_TABLE=items
