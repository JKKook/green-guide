{
  "$description": "GreenGuide(그린가이드) 디자인 토큰 — waste_app 실측값 (app_theme.dart / confidence.dart / waste_info.dart). W3C Design Tokens draft 형식.",
  "$version": "1.1.0",
  "color": {
    "seed": {
      "brand": { "$type": "color", "$value": "#2E7D32", "$description": "M3 seed · primary (Material Green 800). 다크 모드 primary 도 동일값으로 통일" },
      "secondary": { "$type": "color", "$value": "#C8EFC7", "$description": "M3 secondary seed (Light Green) — 보조 강조·증거 칩·피드백 배너" },
      "tertiary": { "$type": "color", "$value": "#EF6C00", "$description": "M3 tertiary seed (Orange 800) — 다중재질 카드 등 포인트" }
    },
    "surface": {
      "scaffoldLight": { "$type": "color", "$value": "#FAFAFA" },
      "scaffoldDark": { "$type": "color", "$value": "#0F1419" },
      "inkLight": { "$type": "color", "$value": "#0F1419", "$description": "텍스트 강조색 (라이트)" },
      "inkDark": { "$type": "color", "$value": "#FFFFFF" }
    },
    "confidence": {
      "high": { "$type": "color", "$value": "#2E7D32", "$description": "라벨: 확신" },
      "medium": { "$type": "color", "$value": "#F9A825", "$description": "라벨: 보통" },
      "low": { "$type": "color", "$value": "#D32F2F", "$description": "라벨: 불확실" }
    },
    "material": {
      "paper": { "$type": "color", "$value": "#8D6E63", "$description": "종이류" },
      "paper_pack": { "$type": "color", "$value": "#8D6E63", "$description": "종이팩" },
      "glass": { "$type": "color", "$value": "#26A69A", "$description": "유리류" },
      "metal": { "$type": "color", "$value": "#90A4AE", "$description": "캔·고철" },
      "plastic": { "$type": "color", "$value": "#42A5F5", "$description": "플라스틱" },
      "vinyl": { "$type": "color", "$value": "#7E57C2", "$description": "비닐류" },
      "styrofoam": { "$type": "color", "$value": "#ECEFF1", "$description": "스티로폼" },
      "clothes": { "$type": "color", "$value": "#EC407A", "$description": "의류" },
      "food_waste": { "$type": "color", "$value": "#8BC34A", "$description": "음식물" },
      "electronics": { "$type": "color", "$value": "#5C6BC0", "$description": "전자제품" },
      "hazardous": { "$type": "color", "$value": "#D32F2F", "$description": "유해폐기물" },
      "trash": { "$type": "color", "$value": "#757575", "$description": "일반쓰레기" },
      "etc": { "$type": "color", "$value": "#9E9E9E", "$description": "기타/분류 불가" },
      "non_object": { "$type": "color", "$value": "#BDBDBD", "$description": "분류 대상 아님" }
    }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "12px", "$description": "칩·타일" },
    "medium": { "$type": "dimension", "$value": "16px", "$description": "카드·힌트" },
    "large": { "$type": "dimension", "$value": "22px", "$description": "프리뷰·결과 카드·지역 카드" },
    "xl": { "$type": "dimension", "$value": "28px" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "s": { "$type": "dimension", "$value": "8px" },
    "m": { "$type": "dimension", "$value": "12px" },
    "l": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "xxl": { "$type": "dimension", "$value": "32px" }
  },
  "motion": {
    "pageTransition": { "$type": "duration", "$value": "380ms", "$description": "easeOutCubic" },
    "cardEnter": { "$type": "duration", "$value": "450ms" },
    "fadeShort": { "$type": "duration", "$value": "220ms" }
  },
  "typography": {
    "family": {
      "korean": { "$type": "fontFamily", "$value": ["Apple SD Gothic Neo", "Noto Sans KR", "system-ui"], "$description": "시스템 고딕 (앱은 M3 Typography.material2021 기본)" }
    },
    "emphasis": {
      "headingWeight": { "$type": "fontWeight", "$value": 700 },
      "headingLetterSpacing": { "$type": "dimension", "$value": "-0.5px" },
      "bodyLineHeight": { "$type": "number", "$value": 1.5 }
    }
  },
  "components": {
    "$description": "app_theme.dart 테마 오버라이드 + 화면 위젯 실측 (단위: px). alpha 는 0~1 불투명도.",
    "appBar": {
      "background": "scaffold", "elevation": 0, "scrolledUnderElevation": 0.6,
      "centerTitle": false, "surfaceTint": "none"
    },
    "button": {
      "height": 54, "radius": 16, "fontSize": 15, "fontWeight": 600,
      "variants": ["filled", "outlined", "tonal", "text"],
      "filled": { "background": "primary", "foreground": "onPrimary" },
      "outlined": { "border": { "color": "outlineVariant", "width": 1.4 }, "foreground": "primary" }
    },
    "iconButton": { "size": 24, "foreground": "onSurface" },
    "fab": { "radius": 16, "elevation": 3, "background": "primary" },
    "card": {
      "radius": 22, "elevation": 0, "margin": 0,
      "background": { "light": "#FFFFFF", "dark": "#1A2027" },
      "border": { "color": "outlineVariant", "alpha": { "light": 0.5, "dark": 0.4 }, "width": 1 },
      "padding": 16
    },
    "chip": {
      "radius": 12, "background": { "light": "#F1F3F5", "dark": "#1A2027" },
      "border": { "color": "outlineVariant", "alpha": { "light": 0.4, "dark": 0.3 } }
    },
    "input": {
      "radius": 16, "filled": true, "fill": { "light": "#F1F3F5", "dark": "#1A2027" },
      "border": "none", "focusBorder": { "color": "primary", "width": 2 },
      "padding": { "x": 16, "y": 16 }
    },
    "listTile": { "radius": 16, "padding": { "x": 16, "y": 4 } },
    "divider": { "color": "outlineVariant", "alpha": 0.4, "thickness": 1 },
    "snackBar": { "behavior": "floating", "radius": 16, "background": "inverseSurface" },
    "bottomSheet": { "topRadius": 28, "background": "scaffold", "dragHandle": true },
    "dialog": { "radius": 28, "background": { "light": "#FFFFFF", "dark": "#1A2027" } },

    "predictionCard": {
      "$description": "결과 카드 (_PredictionCard) — accent = 재질색(color.material.*)",
      "radius": 22, "padding": 16,
      "background": { "gradient": ["accent@0.18", "accent@0.05"], "direction": "topLeft→bottomRight" },
      "border": { "color": "accent", "alpha": 0.3, "width": 1 },
      "iconCircle": { "size": 64, "background": "accent", "iconSize": 34, "iconColor": "#FFFFFF" },
      "title": { "style": "headlineSmall", "fontWeight": 700 },
      "confidence": { "dotSize": 8, "fontSize": 13, "fontWeight": 700, "color": "color.confidence.*" }
    },
    "hierBadgeChip": {
      "$description": "계층 경로 칩 (HierBadge) — 대분류 → 세부",
      "radius": 12, "padding": { "x": 10, "y": 5 },
      "background": { "color": "accent", "alpha": { "emphasized": 0.18, "default": 0.10 } },
      "border": { "color": "accent", "alpha": 0.35 },
      "fontSize": 12, "fontWeight": { "emphasized": 700, "default": 600 }, "iconSize": 14
    },
    "regionBadge": {
      "$description": "오버레이 재질 라벨 배지 (_RegionBadge) — 사진 위 bbox 상단",
      "radius": 20, "padding": { "x": 10, "y": 6 }, "maxWidth": 116,
      "background": "accent", "foreground": "#FFFFFF", "fontSize": 13, "fontWeight": 700,
      "iconSize": 16, "shadow": { "color": "#000000", "alpha": 0.4, "blur": 6, "y": 2 }
    },
    "evidenceChip": {
      "$description": "판정 근거 칩 (_EvidenceChips) — mark=recycling, identity=visibility, vlm=auto_awesome, 기타=notes",
      "radius": "full", "padding": { "x": 10, "y": 6 },
      "background": { "color": "secondaryContainer", "alpha": 0.55 },
      "border": { "color": "outlineVariant", "width": 1 },
      "fontSize": 11.5, "fontWeight": 600, "iconSize": 14
    },
    "regionCard": {
      "$description": "우리 동네 배출 안내 (_RegionCard)",
      "radius": 22, "padding": 12, "background": "surfaceContainerLow",
      "border": { "color": "outlineVariant", "width": 1 },
      "labelColumnWidth": 64, "rowFontSize": 12.5, "sourceFontSize": 10.5
    },
    "objectsCard": {
      "$description": "다중 물건 후보 (_ObjectsCard/_ObjectTile)",
      "radius": 22, "padding": 12, "background": "surfaceContainerLow",
      "tile": {
        "radius": 12, "padding": { "x": 8, "y": 8 }, "numberCircle": 22,
        "selected": { "background": "accent@0.10", "border": "accent@0.5" }
      }
    },
    "objectMarker": {
      "$description": "사진 위 물건 번호 마커 (_ObjectMarker)",
      "size": 22, "background": "#FFFFFF", "fontWeight": 800,
      "selectedRing": { "color": "accent", "width": 2.5 }
    },
    "overlayChip": {
      "$description": "사진 위 반투명 칩 — 되돌리기·힌트 공용",
      "radius": "full", "background": "#000000@0.54", "foreground": "#FFFFFF",
      "undo": { "padding": { "x": 12, "y": 6 }, "fontSize": 12, "iconSize": 15 },
      "hint": { "padding": { "x": 10, "y": 5 }, "fontSize": 11.5 }
    },
    "tapMarker": { "size": 20, "ring": { "color": "#FFFFFF", "width": 2.5 }, "halo": "accent@0.35" },
    "feedbackPrompt": {
      "radius": 16, "padding": { "x": 16, "y": 12 },
      "background": { "color": "secondaryContainer", "alpha": 0.5 }, "fontWeight": 600
    },
    "actionBar": {
      "$description": "결과 시트 하단 고정 바 (_ActionBar)",
      "padding": { "x": 16, "y": 12 }, "background": "scaffold",
      "topBorder": { "color": "outlineVariant", "alpha": 0.3, "width": 1 },
      "buttons": ["outlined:다시 촬영", "filled:완료"]
    },
    "koreaMap": {
      "$description": "지역 선택 지도 (KoreaMap)",
      "fill": { "color": "primaryContainer", "alpha": 0.45 },
      "pressedFill": { "color": "primary", "alpha": 0.55 },
      "stroke": { "color": "primary", "alpha": 0.65 },
      "callout": { "width": 0.13, "height": 0.052, "gap": 0.062, "sides": { "west": ["인천", "서울", "세종", "대전", "광주"], "east": ["대구", "울산", "부산"] } },
      "maxZoom": 6
    }
  }
}
